rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == 'sy7uYYhHSDaukxkqeAKcSQ0L4rP2'
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && adminData().isActive == true
            && adminData().role in ['admin', 'superAdmin']
          )
        );
    }

    function sellerData() {
      return get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data;
    }

    function isActiveSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && sellerData().isActive == true
        && sellerData().role == 'seller';
    }

    function customerData() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid)).data;
    }

    function hasCustomerSession() {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && customerData().isActive == true
        && customerData().role == 'customer'
        && customerData().customerId is string;
    }

    function driverData() {
      return get(/databases/$(database)/documents/delivery_persons/$(request.auth.uid)).data;
    }

    function isActiveDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/delivery_persons/$(request.auth.uid))
        && driverData().isActive == true
        && driverData().isApproved == true
        && driverData().role == 'delivery_person';
    }

    function rideDriverData() {
      return get(/databases/$(database)/documents/ride_drivers/$(request.auth.uid)).data;
    }

    function isActiveRideDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/ride_drivers/$(request.auth.uid))
        && rideDriverData().isActive == true
        && rideDriverData().isApproved == true
        && rideDriverData().drivingLicenseVerified == true
        && rideDriverData().role == 'ride_driver';
    }

    function busOperatorData() {
      return get(
        /databases/$(database)/documents/bus_operators/$(request.auth.uid)
      ).data;
    }

    function isActiveBusOperator() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/bus_operators/$(request.auth.uid)
        )
        && busOperatorData().role == 'busOperator'
        && busOperatorData().isApproved == true
        && busOperatorData().isActive == true;
    }


    // ============================================================
    // RD HOTEL PARTNER HELPERS
    // ============================================================
    function hotelPartnerData() {
      return get(
        /databases/$(database)/documents/hotel_partners/$(request.auth.uid)
      ).data;
    }

    function isActiveHotelPartner() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/hotel_partners/$(request.auth.uid)
        )
        && hotelPartnerData().role == 'hotel_partner'
        && hotelPartnerData().isApproved == true
        && hotelPartnerData().isActive == true;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /customers/{authUid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == authUid);

      allow create: if signedIn()
        && request.auth.uid == authUid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == authUid
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive)
        || (signedIn()
          && request.auth.uid == authUid
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.linkedViaCode is string
          && exists(
            /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
          )
          && get(
            /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
          ).data.used == true
          && get(
            /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
          ).data.usedByUid == request.auth.uid
          && get(
            /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
          ).data.expiresAt > request.time
          && request.resource.data.customerId == get(
            /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
          ).data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerId',
            'linkedViaCode',
            'linkedAt',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    match /customer_device_links/{linkCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if (
          (
            hasCustomerSession()
            && request.resource.data.customerId == customerData().customerId
            && request.resource.data.createdByUid == request.auth.uid
          )
          || (
            isAdmin()
            && request.resource.data.customerId is string
            && request.resource.data.customerId.size() > 0
            && request.resource.data.createdByUid == request.auth.uid
          )
        )
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.keys().hasOnly([
          'customerId',
          'createdByUid',
          'createdAt',
          'expiresAt',
          'used'
        ]);

      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'used',
          'usedByUid',
          'usedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /sellers/{sellerId} {
      // Customer pages and tracking need seller shop/contact/location data.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == sellerId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.role == 'seller'
        && request.resource.data.isActive == false;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == sellerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive);

      allow delete: if isAdmin();
    }

    match /delivery_persons/{driverId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == driverId)
        || (isActiveSeller()
          && resource.data.isActive == true
          && resource.data.isApproved == true);

      allow create: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.deliveryPersonId == request.auth.uid
        && request.resource.data.role == 'delivery_person'
        && request.resource.data.isApproved == false;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == driverId
          && request.resource.data.deliveryPersonId == resource.data.deliveryPersonId
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isOnline',
            'updatedAt',
            'latitude',
            'longitude',
            'locationUpdatedAt',
            'currentOrderId'
          ]));

      allow delete: if isAdmin();
    }


    match /ride_drivers/{rideDriverId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == rideDriverId)
        || (signedIn()
          && resource.data.isActive == true
          && resource.data.isOnline == true);

      allow create: if signedIn()
        && request.auth.uid == rideDriverId
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role == 'ride_driver'
        && request.resource.data.isActive == false
        && request.resource.data.isApproved == false
        && request.resource.data.isOnline == false
        && request.resource.data.drivingLicenseNumber is string
        && request.resource.data.drivingLicenseNumber.size() > 0
        && request.resource.data.drivingLicenseExpiry is string
        && request.resource.data.drivingLicenseExpiry.size() > 0
        && request.resource.data.drivingLicenseFrontUrl is string
        && request.resource.data.drivingLicenseFrontUrl.size() > 0
        && request.resource.data.drivingLicenseBackUrl is string
        && request.resource.data.drivingLicenseBackUrl.size() > 0
        && request.resource.data.drivingLicenseVerified == false
        && request.resource.data.driverAgreementAccepted == true
        && request.resource.data.driverAgreementVersion == 'RD-RIDE-DRIVER-1.0'
        && request.resource.data.driverAgreementAcceptedName is string
        && request.resource.data.driverAgreementAcceptedName
          == request.resource.data.name
        && request.resource.data.driverAgreementTextHash is string
        && request.resource.data.driverAgreementTextHash.size() == 64
        && request.resource.data.driverAgreementTextSnapshot is string
        && request.resource.data.driverAgreementTextSnapshot.size() >= 1000
        && request.resource.data.driverAgreementTextSnapshot.size() <= 30000
        && request.resource.data.driverAgreementAcceptedAt is timestamp
        && request.resource.data.driverAgreementReacceptRequired == false;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == rideDriverId
          && resource.data.driverId == request.auth.uid
          && resource.data.authUid == request.auth.uid
          && resource.data.role == 'ride_driver'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'phone',
            'vehicleType',
            'vehicleNumber',
            'photoUrl',
            'isOnline',
            'latitude',
            'longitude',
            'locationUpdatedAt',
            'currentRideRequestId',
            'fcmToken',
            'fcmTokens',
            'fcmTokenUpdatedAt',
            'notificationsEnabled',
            'updatedAt'
          ])
          && (
            !('fcmToken' in request.resource.data)
            || (
              request.resource.data.fcmToken is string
              && request.resource.data.fcmToken.size() <= 4096
            )
          )
          && (
            !('fcmTokens' in request.resource.data)
            || (
              request.resource.data.fcmTokens is list
              && request.resource.data.fcmTokens.size() <= 20
            )
          )
          && (
            !('notificationsEnabled' in request.resource.data)
            || request.resource.data.notificationsEnabled is bool
          )
          && (
            request.resource.data.isOnline == false
            || (
              resource.data.isActive == true
              && resource.data.isApproved == true
              && resource.data.drivingLicenseVerified == true
              && resource.data.get('approvalStatus', '') != 'suspended'
            )
          ))
        || (signedIn()
          && request.auth.uid == rideDriverId
          && resource.data.driverId == request.auth.uid
          && resource.data.authUid == request.auth.uid
          && resource.data.role == 'ride_driver'
          && resource.data.isApproved == true
          && resource.data.isActive == false
          && resource.data.get('approvalStatus', '') == 'suspended'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.reactivationStatus == 'pending_admin_review'
          && request.resource.data.reactivationPaymentMethod is string
          && request.resource.data.reactivationPaymentMethod.size() > 0
          && request.resource.data.reactivationPaymentAmount is number
          && request.resource.data.reactivationPaymentAmount >= 0
          && request.resource.data.reactivationPaymentAmount
            >= resource.data.suspensionTotalDue
          && request.resource.data.reactivationPaymentReference is string
          && request.resource.data.reactivationPaymentReference.size() <= 120
          && request.resource.data.reactivationPaymentNote is string
          && request.resource.data.reactivationPaymentNote.size() <= 300
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reactivationStatus',
            'reactivationPaymentMethod',
            'reactivationPaymentAmount',
            'reactivationPaymentReference',
            'reactivationPaymentNote',
            'reactivationRequestedAt',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    // Immutable account action log. Admin writes suspension/reactivation
    // events; the driver may read only their own account history.
    match /ride_driver_account_history/{eventId} {
      allow read: if isAdmin()
        || (signedIn()
          && resource.data.driverId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.eventId == eventId
        && request.resource.data.driverId is string
        && request.resource.data.driverId.size() > 0
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0;
      allow update, delete: if false;
    }


    // ============================================================
    // RD RIDE BUSINESS SETTINGS
    // ============================================================
    // Signed-in customers/drivers may read the current commission so each
    // new ride can snapshot it. Only Admin/SuperAdmin may change it.
    match /ride_business_settings/{settingsId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    match /ride_requests/{rideRequestId} {
      function rideDriverOwnsRequest() {
        return isActiveRideDriver()
          && resource.data.driverId == request.auth.uid;
      }

      function assignedRideDriverCanRead() {
        return signedIn()
          && exists(/databases/$(database)/documents/ride_drivers/$(request.auth.uid))
          && rideDriverData().isApproved == true
          && rideDriverData().role == 'ride_driver'
          && resource.data.driverId == request.auth.uid;
      }

      function customerOwnsRequest() {
        return signedIn()
          && resource.data.customerAuthUid == request.auth.uid;
      }

      function rideCommissionPercentSnapshot() {
        return resource.data.get('rdCommissionPercent', 0.0);
      }

      function rideIdentityUnchanged() {
        return request.resource.data.rideRequestId == resource.data.rideRequestId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerAuthUid == resource.data.customerAuthUid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.requestType == resource.data.requestType
          && request.resource.data.vehicleType == resource.data.vehicleType
          && request.resource.data.pickupAddress == resource.data.pickupAddress
          && request.resource.data.destinationAddress == resource.data.destinationAddress;
      }

      allow read: if isAdmin()
        || (signedIn()
          && resource.data.customerAuthUid == request.auth.uid)
        || assignedRideDriverCanRead();

      allow create: if signedIn()
        && request.resource.data.rideRequestId == rideRequestId
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.driverId is string
        && request.resource.data.driverId.size() > 0
        && request.resource.data.vehicleType is string
        && request.resource.data.vehicleType.size() > 0
        && request.resource.data.pickupAddress is string
        && request.resource.data.pickupAddress.size() > 0
        && request.resource.data.destinationAddress is string
        && request.resource.data.destinationAddress.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.requestType == 'ride_now'
        && request.resource.data.driverResponse == 'waiting'
        && request.resource.data.estimatedFare is number
        && request.resource.data.estimatedFare > 0
        && request.resource.data.rdCommissionPercent is number
        && request.resource.data.rdCommissionPercent >= 0
        && request.resource.data.rdCommissionPercent <= 50
        && request.resource.data.estimatedRdCommission is number
        && request.resource.data.estimatedRdCommission
          == request.resource.data.estimatedFare
            * request.resource.data.rdCommissionPercent / 100.0
        && request.resource.data.estimatedDriverIncome is number
        && request.resource.data.estimatedDriverIncome
          == request.resource.data.estimatedFare
            - request.resource.data.estimatedRdCommission;

      allow update: if isAdmin()
        || (customerOwnsRequest()
          && rideIdentityUnchanged()
          && resource.data.status == 'completed'
          && request.resource.data.status == 'completed'
          && !resource.data.keys().hasAny([
            'driverRating',
            'driverReview',
            'driverRatedAt',
            'driverRatingVersion'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverRating',
            'driverReview',
            'driverRatedAt',
            'driverRatingVersion',
            'updatedAt'
          ])
          && request.resource.data.driverRating is int
          && request.resource.data.driverRating >= 1
          && request.resource.data.driverRating <= 5
          && request.resource.data.driverReview is string
          && request.resource.data.driverReview.size() <= 500
          && request.resource.data.driverRatedAt is timestamp
          && request.resource.data.driverRatingVersion == 1
          && request.resource.data.updatedAt is timestamp)
        || (customerOwnsRequest()
          && rideIdentityUnchanged()
          && resource.data.status in ['pending', 'accepted', 'arrived']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancelledBy',
            'cancellationReason',
            'cancellationPreviousStatus',
            'cancellationFee',
            'cancellationCurrency',
            'cancellationFeeStatus',
            'cancelledAt',
            'updatedAt'
          ])
          && request.resource.data.cancelledBy == 'customer'
          && request.resource.data.cancellationReason is string
          && request.resource.data.cancellationReason.size() > 0
          && request.resource.data.cancellationReason.size() <= 200
          && request.resource.data.cancellationPreviousStatus
            == resource.data.status
          && request.resource.data.cancellationCurrency
            == resource.data.currency
          && request.resource.data.cancellationFee is number
          && request.resource.data.cancellationFee >= 0
          && request.resource.data.cancelledAt is timestamp
          && (
            (
              resource.data.status == 'pending'
              && request.resource.data.cancellationFee == 0
              && request.resource.data.cancellationFeeStatus == 'not_required'
            )
            || (
              resource.data.status in ['accepted', 'arrived']
              && (
                (
                  resource.data.get('fareBaseFare', 0.0) > 0
                  && request.resource.data.cancellationFee
                    == resource.data.get('fareBaseFare', 0.0)
                  && request.resource.data.cancellationFeeStatus == 'due'
                )
                || (
                  resource.data.get('fareBaseFare', 0.0) <= 0
                  && request.resource.data.cancellationFee == 0
                  && request.resource.data.cancellationFeeStatus
                    == 'not_required'
                )
              )
            )
          ))
        || (rideDriverOwnsRequest()
          && rideIdentityUnchanged()
          && (
            (
              resource.data.status == 'pending'
              && resource.data.driverResponse == 'waiting'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'driverResponse',
                'acceptedAt',
                'rejectedAt',
                'updatedAt'
              ])
              && (
                (request.resource.data.status == 'accepted'
                  && request.resource.data.driverResponse == 'accepted')
                || (request.resource.data.status == 'rejected'
                  && request.resource.data.driverResponse == 'rejected')
              )
            )
            || (
              resource.data.status in ['accepted', 'arrived']
              && resource.data.driverResponse == 'accepted'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.driverResponse == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'cancelledBy',
                'cancellationReason',
                'cancellationPreviousStatus',
                'cancellationFee',
                'cancellationCurrency',
                'cancellationFeeStatus',
                'cancelledAt',
                'updatedAt'
              ])
              && request.resource.data.cancelledBy == 'driver'
              && request.resource.data.cancellationReason is string
              && request.resource.data.cancellationReason.size() > 0
              && request.resource.data.cancellationReason.size() <= 200
              && request.resource.data.cancellationPreviousStatus == resource.data.status
              && request.resource.data.cancellationFee == 0
              && request.resource.data.cancellationCurrency
                == resource.data.currency
              && request.resource.data.cancellationFeeStatus == 'not_required'
              && request.resource.data.cancelledAt is timestamp
            )
            || (
              resource.data.status == 'accepted'
              && resource.data.driverResponse == 'accepted'
              && request.resource.data.status == 'arrived'
              && request.resource.data.driverResponse == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'arrivedAt',
                'updatedAt'
              ])
              && request.resource.data.arrivedAt is timestamp
            )
            || (
              resource.data.status == 'arrived'
              && resource.data.driverResponse == 'accepted'
              && request.resource.data.status == 'in_progress'
              && request.resource.data.driverResponse == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'tripStartedAt',
                'tripStartOtpVerifiedAt',
                'actualDistanceKm',
                'tripDistanceLastLatitude',
                'tripDistanceLastLongitude',
                'tripDistanceLastPositionAt',
                'tripDistanceUpdatedAt',
                'updatedAt'
              ])
            )
            || (
              resource.data.status == 'in_progress'
              && resource.data.driverResponse == 'accepted'
              && request.resource.data.status == 'in_progress'
              && request.resource.data.driverResponse == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'actualDistanceKm',
                'liveFare',
                'tripDistanceLastLatitude',
                'tripDistanceLastLongitude',
                'tripDistanceLastPositionAt',
                'tripDistanceUpdatedAt',
                'updatedAt'
              ])
              && request.resource.data.actualDistanceKm is number
              && request.resource.data.liveFare is number
              && request.resource.data.actualDistanceKm >= resource.data.actualDistanceKm
              && request.resource.data.liveFare >= 0
            )
            || (
              resource.data.status == 'in_progress'
              && resource.data.driverResponse == 'accepted'
              && request.resource.data.status == 'completed'
              && request.resource.data.driverResponse == 'accepted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'tripCompletedAt',
                'finalDistanceKm',
                'finalFare',
                'finalRdCommission',
                'driverNetIncome',
                'updatedAt'
              ])
              && request.resource.data.finalDistanceKm is number
              && request.resource.data.finalDistanceKm >= 0
              && request.resource.data.finalFare is number
              && request.resource.data.finalFare >= 0
              && request.resource.data.finalRdCommission is number
              && request.resource.data.finalRdCommission >= 0
              && request.resource.data.driverNetIncome is number
              && request.resource.data.driverNetIncome >= 0
              && request.resource.data.finalRdCommission
                == request.resource.data.finalFare
                  * rideCommissionPercentSnapshot() / 100.0
              && request.resource.data.driverNetIncome
                == request.resource.data.finalFare
                  - request.resource.data.finalRdCommission
            )
          ));

      allow delete: if isAdmin();

      // Customer-only private data for a ride. The real Trip Start OTP is
      // stored here so the assigned driver can only see the hash on the
      // parent ride request and must ask the customer for the 6-digit code.
      match /private/{privateDoc} {
        function parentRideAfterCreate() {
          return getAfter(
            /databases/$(database)/documents/ride_requests/$(rideRequestId)
          ).data;
        }

        function parentRide() {
          return get(
            /databases/$(database)/documents/ride_requests/$(rideRequestId)
          ).data;
        }

        allow read: if isAdmin()
          || (signedIn()
            && parentRide().customerAuthUid == request.auth.uid);

        allow create: if signedIn()
          && privateDoc == 'customer'
          && parentRideAfterCreate().customerAuthUid == request.auth.uid
          && request.resource.data.rideRequestId == rideRequestId
          && request.resource.data.tripStartOtp is string
          && request.resource.data.tripStartOtp.matches('^[0-9]{6}$');

        allow update: if isAdmin();

        // After the driver successfully verifies the OTP, the real 6-digit
        // value is deleted in the same batch. Only the parent verification
        // timestamp remains as evidence.
        allow delete: if isAdmin()
          || (
            signedIn()
            && parentRideAfterCreate().customerAuthUid == request.auth.uid
            && parentRideAfterCreate().status == 'cancelled'
            && parentRideAfterCreate().cancelledBy == 'customer'
          )
          || (
            isActiveRideDriver()
            && parentRideAfterCreate().driverId == request.auth.uid
            && (
              (
                parentRideAfterCreate().status == 'in_progress'
                && parentRideAfterCreate().tripStartOtpVerifiedAt is timestamp
              )
              || (
                parentRideAfterCreate().status == 'cancelled'
                && parentRideAfterCreate().cancelledBy == 'driver'
              )
            )
          );
      }

      // Private real-time chat between the customer and the assigned Ride
      // Driver. Customer/driver can read only while the ride is active.
      // After completion the evidence is Admin-only and immutable.
      match /messages/{messageId} {
        function chatRide() {
          return get(
            /databases/$(database)/documents/ride_requests/$(rideRequestId)
          ).data;
        }

        function chatCustomer() {
          return signedIn()
            && chatRide().customerAuthUid == request.auth.uid;
        }

        function chatDriver() {
          return isActiveRideDriver()
            && chatRide().driverId == request.auth.uid;
        }

        function activeRideChat() {
          return chatRide().status in ['accepted', 'arrived', 'in_progress'];
        }

        function validChatSenderRole() {
          return request.resource.data.senderRole is string
            && (
              (request.resource.data.senderRole == 'customer'
                && chatCustomer())
              || (request.resource.data.senderRole == 'driver'
                && chatDriver())
              || (request.resource.data.senderRole == 'admin'
                && isAdmin())
            );
        }

        function validEvidenceExpiry() {
          return request.resource.data.evidenceExpiresAt is timestamp
            && request.resource.data.evidenceExpiresAt
              >= request.time + duration.value(89, 'd')
            && request.resource.data.evidenceExpiresAt
              <= request.time + duration.value(91, 'd');
        }

        function validTextMessage() {
          return request.resource.data.messageType == 'text'
            && request.resource.data.get('text', '') is string
            && request.resource.data.get('text', '').size() > 0
            && request.resource.data.get('text', '').size() <= 1000;
        }

        function validVoiceMessage() {
          return request.resource.data.messageType == 'voice'
            && request.resource.data.get('text', '') == ''
            && request.resource.data.get('voicePayloadId', '') == messageId
            && request.resource.data.get('voiceDurationSeconds', 0) is int
            && request.resource.data.get('voiceDurationSeconds', 0) >= 1
            && request.resource.data.get('voiceDurationSeconds', 0) <= 20
            && request.resource.data.get('voiceByteLength', 0) is int
            && request.resource.data.get('voiceByteLength', 0) > 44
            && request.resource.data.get('voiceByteLength', 0) <= 700000
            && request.resource.data.get('voiceMimeType', '') == 'audio/wav';
        }

        allow read: if isAdmin()
          || ((chatCustomer() || chatDriver()) && activeRideChat());

        allow create: if (chatCustomer() || chatDriver() || isAdmin())
          && activeRideChat()
          && request.resource.data.messageId == messageId
          && request.resource.data.rideRequestId == rideRequestId
          && request.resource.data.senderUid == request.auth.uid
          && validChatSenderRole()
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && validEvidenceExpiry()
          && (validTextMessage() || validVoiceMessage());

        // Evidence is append-only. Customer, driver and Admin cannot edit or
        // manually delete original messages. Firestore TTL may remove them
        // automatically after evidenceExpiresAt.
        allow update, delete: if false;
      }

      // Voice payload is stored separately from message metadata so normal
      // chat loading stays small. It is fetched only when Play is pressed.
      // Customer/driver can read it only while the ride is active; Admin can
      // review it during the evidence retention period.
      match /message_audio/{messageId} {
        function audioRide() {
          return get(
            /databases/$(database)/documents/ride_requests/$(rideRequestId)
          ).data;
        }

        function audioCustomer() {
          return signedIn()
            && audioRide().customerAuthUid == request.auth.uid;
        }

        function audioDriver() {
          return isActiveRideDriver()
            && audioRide().driverId == request.auth.uid;
        }

        function activeAudioChat() {
          return audioRide().status in ['accepted', 'arrived', 'in_progress'];
        }

        function pairedMessageAfterCreate() {
          return getAfter(
            /databases/$(database)/documents/ride_requests/$(rideRequestId)/messages/$(messageId)
          ).data;
        }

        function validAudioSenderRole() {
          return request.resource.data.senderRole is string
            && (
              (request.resource.data.senderRole == 'customer'
                && audioCustomer())
              || (request.resource.data.senderRole == 'driver'
                && audioDriver())
              || (request.resource.data.senderRole == 'admin'
                && isAdmin())
            );
        }

        allow read: if isAdmin()
          || ((audioCustomer() || audioDriver()) && activeAudioChat());

        allow create: if (audioCustomer() || audioDriver() || isAdmin())
          && activeAudioChat()
          && request.resource.data.messageId == messageId
          && request.resource.data.rideRequestId == rideRequestId
          && request.resource.data.senderUid == request.auth.uid
          && validAudioSenderRole()
          && request.resource.data.audioData is bytes
          && request.resource.data.audioData.size() > 44
          && request.resource.data.audioData.size() <= 700000
          && request.resource.data.byteLength is int
          && request.resource.data.byteLength
            == request.resource.data.audioData.size()
          && request.resource.data.contentType == 'audio/wav'
          && request.resource.data.evidenceExpiresAt is timestamp
          && request.resource.data.evidenceExpiresAt
            >= request.time + duration.value(89, 'd')
          && request.resource.data.evidenceExpiresAt
            <= request.time + duration.value(91, 'd')
          && pairedMessageAfterCreate().messageType == 'voice'
          && pairedMessageAfterCreate().messageId == messageId
          && pairedMessageAfterCreate().rideRequestId == rideRequestId
          && pairedMessageAfterCreate().senderUid == request.auth.uid
          && pairedMessageAfterCreate().senderRole
            == request.resource.data.senderRole
          && pairedMessageAfterCreate().voicePayloadId == messageId
          && pairedMessageAfterCreate().voiceByteLength
            == request.resource.data.byteLength;

        allow update, delete: if false;
      }
    }

    // RD Ride SOS alerts. One active slot is used per ride + sender role
    // to prevent repeated taps from creating duplicate active alerts.
    match /ride_sos_alerts/{alertId} {
      function sourceRidePath() {
        return /databases/$(database)/documents/ride_requests/$(request.resource.data.rideRequestId);
      }

      function sourceRideExists() {
        return exists(sourceRidePath());
      }

      function sourceRide() {
        return get(sourceRidePath()).data;
      }

      function validSosCreateShape() {
        return request.resource.data.keys().hasOnly([
          'rideRequestId',
          'customerAuthUid',
          'customerId',
          'driverId',
          'triggeredBy',
          'triggeredByUid',
          'reason',
          'status',
          'customerName',
          'customerPhone',
          'driverName',
          'driverPhone',
          'rideStatusSnapshot',
          'pickupAddress',
          'destinationAddress',
          'latitude',
          'longitude',
          'locationAddress',
          'createdAt',
          'updatedAt',
          'resolvedAt'
        ])
        && request.resource.data.rideRequestId is string
        && request.resource.data.rideRequestId.size() > 0
        && request.resource.data.customerAuthUid is string
        && request.resource.data.customerAuthUid.size() > 0
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.driverId is string
        && request.resource.data.driverId.size() > 0
        && request.resource.data.triggeredBy in ['customer', 'driver']
        && request.resource.data.triggeredByUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && request.resource.data.status == 'active'
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.driverName is string
        && request.resource.data.driverPhone is string
        && request.resource.data.rideStatusSnapshot
          in ['accepted', 'arrived', 'in_progress']
        && request.resource.data.pickupAddress is string
        && request.resource.data.destinationAddress is string
        && (
          request.resource.data.latitude == null
          || (
            request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
          )
        )
        && (
          request.resource.data.longitude == null
          || (
            request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
          )
        )
        && request.resource.data.locationAddress is string
        && request.resource.data.locationAddress.size() <= 250
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.resolvedAt == null;
      }

      function sosAlertIdMatches() {
        return alertId
          == request.resource.data.rideRequestId
            + '__'
            + request.resource.data.triggeredBy;
      }

      function sosMatchesSourceRide() {
        return sourceRideExists()
          && sourceRide().status in ['accepted', 'arrived', 'in_progress']
          && request.resource.data.rideStatusSnapshot == sourceRide().status
          && request.resource.data.customerAuthUid
            == sourceRide().customerAuthUid
          && request.resource.data.customerId == sourceRide().customerId
          && request.resource.data.driverId == sourceRide().driverId
          && request.resource.data.customerName
            == sourceRide().get('customerName', '')
          && request.resource.data.customerPhone
            == sourceRide().get('customerPhone', '')
          && request.resource.data.driverName
            == sourceRide().get('driverName', '')
          && request.resource.data.driverPhone
            == sourceRide().get('driverPhone', '')
          && request.resource.data.pickupAddress
            == sourceRide().get('pickupAddress', '')
          && request.resource.data.destinationAddress
            == sourceRide().get('destinationAddress', '');
      }

      function customerCanCreateSos() {
        return request.resource.data.triggeredBy == 'customer'
          && sourceRide().customerAuthUid == request.auth.uid;
      }

      function driverCanCreateSos() {
        return request.resource.data.triggeredBy == 'driver'
          && sourceRide().driverId == request.auth.uid;
      }

      allow create: if signedIn()
        && validSosCreateShape()
        && sosAlertIdMatches()
        && sosMatchesSourceRide()
        && (
          customerCanCreateSos()
          || driverCanCreateSos()
        );

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerAuthUid == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
        );

      allow update: if (
        isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'resolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'resolvedAt',
          'updatedAt'
        ])
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.updatedAt is timestamp
      )
      || (
        signedIn()
        && resource.data.status in ['active', 'resolved']
        && request.resource.data.status == 'active'
        && validSosCreateShape()
        && sosAlertIdMatches()
        && sosMatchesSourceRide()
        && request.resource.data.rideRequestId == resource.data.rideRequestId
        && request.resource.data.customerAuthUid == resource.data.customerAuthUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.triggeredBy == resource.data.triggeredBy
        && request.resource.data.triggeredByUid == resource.data.triggeredByUid
        && (
          customerCanCreateSos()
          || driverCanCreateSos()
        )
      );

      allow delete: if isAdmin();
    }

    match /ride_driver_ratings/{rideRequestId} {
      function sourceRatedRide() {
        return getAfter(
          /databases/$(database)/documents/ride_requests/$(rideRequestId)
        ).data;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'rideRequestId',
          'driverId',
          'rating',
          'createdAt',
          'ratingVersion'
        ])
        && request.resource.data.rideRequestId == rideRequestId
        && request.resource.data.driverId is string
        && request.resource.data.driverId.size() > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is timestamp
        && request.resource.data.ratingVersion == 1
        && sourceRatedRide().status == 'completed'
        && sourceRatedRide().driverId == request.resource.data.driverId
        && sourceRatedRide().driverRating == request.resource.data.rating
        && (
          sourceRatedRide().customerAuthUid == request.auth.uid
          || isAdmin()
          || (
            exists(
              /databases/$(database)/documents/ride_drivers/$(request.auth.uid)
            )
            && rideDriverData().role == 'ride_driver'
            && sourceRatedRide().driverId == request.auth.uid
          )
        );

      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin()
        || (isActiveSeller()
          && request.resource.data.sellerId == request.auth.uid);

      allow update: if isAdmin()
        || (isActiveSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == request.auth.uid);

      allow delete: if isAdmin()
        || (isActiveSeller()
          && resource.data.sellerId == request.auth.uid);
    }

    match /orders/{orderId} {
      function customerOwnsOrder() {
        return hasCustomerSession()
          && resource.data.customerId == customerData().customerId;
      }

      function customerOwnsNewOrder() {
        return hasCustomerSession()
          && request.resource.data.customerId == customerData().customerId;
      }

      function sellerOwnsOrder() {
        return isActiveSeller()
          && resource.data.sellerIds is list
          && request.auth.uid in resource.data.sellerIds;
      }

      function driverOwnsOrder() {
        return isActiveDriver()
          && resource.data.driverId is string
          && resource.data.driverId == request.auth.uid;
      }

      // Keep Admin read isolated from customer/seller/driver checks.
      // Some older orders may not contain sellerIds/driverId; evaluating those
      // role checks in the same expression can deny an otherwise valid Admin
      // collection query. Admin access is therefore its own allow rule.
      allow read: if isAdmin();

      allow read: if customerOwnsOrder()
        || sellerOwnsOrder()
        || driverOwnsOrder();

      allow create: if isAdmin()
        || (customerOwnsNewOrder()
          && request.resource.data.status == 'Pending'
          && request.resource.data.driverId == '');

      allow update: if isAdmin();

      allow update: if customerOwnsOrder()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerLat',
          'customerLng',
          'customerAddress',
          'address',
          'customerLocationUpdatedAt',
          'updatedAt'
        ]);

      // Secure recovery without reading somebody else's order first.
      // The caller must know both the Order ID and the original phone number.
      //
      // New orders use recoveryPhoneKey. Older RD orders may only have
      // phone / customerPhone / mobile, so those legacy fields are accepted
      // as recovery proof as well.
      function recoveryProofMatches() {
        return request.resource.data.recoveryProof is string
          && request.resource.data.recoveryProof.size() >= 6
          && (
            (
              'recoveryPhoneKey' in resource.data
              && resource.data.recoveryPhoneKey is string
              && request.resource.data.recoveryProof
                == resource.data.recoveryPhoneKey
            )
            || (
              'recoveryProof' in resource.data
              && resource.data.recoveryProof is string
              && request.resource.data.recoveryProof
                == resource.data.recoveryProof
            )
            || (
              'phone' in resource.data
              && resource.data.phone is string
              && request.resource.data.recoveryProof
                == resource.data.phone
            )
            || (
              'customerPhone' in resource.data
              && resource.data.customerPhone is string
              && request.resource.data.recoveryProof
                == resource.data.customerPhone
            )
            || (
              'mobile' in resource.data
              && resource.data.mobile is string
              && request.resource.data.recoveryProof
                == resource.data.mobile
            )
          );
      }

      allow update: if hasCustomerSession()
        && recoveryProofMatches()
        && request.resource.data.customerId == customerData().customerId
        && request.resource.data.recoveryPhoneKey
          == request.resource.data.recoveryProof
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerId',
          'recoveryProof',
          'recoveryPhoneKey',
          'recoveredAt',
          'updatedAt'
        ]);

      // Merge orders already owned by the new device into the linked customer.
      allow update: if customerOwnsOrder()
        && request.resource.data.linkedViaCode is string
        && exists(
          /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
        )
        && get(
          /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
        ).data.used == true
        && get(
          /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
        ).data.usedByUid == request.auth.uid
        && get(
          /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
        ).data.expiresAt > request.time
        && request.resource.data.customerId == get(
          /databases/$(database)/documents/customer_device_links/$(request.resource.data.linkedViaCode)
        ).data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerId',
          'linkedViaCode',
          'linkedAt',
          'updatedAt'
        ]);

      allow update: if sellerOwnsOrder()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerIds == resource.data.sellerIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'trackingStatus',
          'updatedAt',
          'deliveryStartedAt',
          'deliveredAt',
          'driverId',
          'driverName',
          'driverPhone',
          'driverEmail',
          'trackingEnabled',
          'deliveryAssignedAt',
          'driverLat',
          'driverLng',
          'driverLocationUpdatedAt'
        ]);

      allow update: if driverOwnsOrder()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerIds == resource.data.sellerIds
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'trackingStatus',
          'updatedAt',
          'deliveryStartedAt',
          'deliveredAt',
          'driverLat',
          'driverLng',
          'driverLocationUpdatedAt',
          'trackingEnabled',
          'deliveryOtp',
          'deliveryOtpCreatedAt',
          'deliveryOtpVerified',
          'deliveryOtpVerifiedAt',
          'deliveryConfirmationMethod',
          'deliveredByDriverId',
          'deliveredByDriverName',
          'deliveredByDriverPhone',
          'deliveryConfirmedLat',
          'deliveryConfirmedLng'
        ])
        && (request.resource.data.status != 'Delivered'
          || (request.resource.data.deliveryOtpVerified == true
            && request.resource.data.deliveredByDriverId == request.auth.uid));

      allow delete: if isAdmin();
    }


    match /reviews/{reviewId} {
      function reviewOrderExists() {
        return request.resource.data.orderId is string
          && exists(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          );
      }

      function reviewOrderData() {
        return get(
          /databases/$(database)/documents/orders/$(request.resource.data.orderId)
        ).data;
      }

      function validReviewContent() {
        return request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 500;
      }

      // Admin can read all reviews.
      allow read: if isAdmin();

      // Active seller can read only reviews belonging to that seller.
      allow read: if isActiveSeller()
        && resource.data.sellerId is string
        && resource.data.sellerId == request.auth.uid;

      // Customer can read only their own submitted review.
      allow read: if hasCustomerSession()
        && resource.data.customerId is string
        && resource.data.customerId == customerData().customerId;

      // Customer can create a review only for an order that:
      // 1) belongs to this customer,
      // 2) is Delivered,
      // 3) contains this seller.
      //
      // Keep create validation intentionally focused on ownership/content.
      // Client metadata such as timestamps/product labels is not used as an
      // authorization condition, which avoids false permission-denied errors.
      allow create: if hasCustomerSession()
        && request.resource.data.reviewId == reviewId
        && request.resource.data.customerId is string
        && request.resource.data.customerId == customerData().customerId
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId.size() > 0
        && validReviewContent()
        && reviewOrderExists()
        && reviewOrderData().customerId == customerData().customerId
        && reviewOrderData().status == 'Delivered'
        && reviewOrderData().sellerIds is list
        && request.resource.data.sellerId in reviewOrderData().sellerIds;

      // Customer may edit only rating/comment/time on their own review.
      // Order/customer/seller/product identity cannot be transferred.
      allow update: if hasCustomerSession()
        && resource.data.customerId == customerData().customerId
        && request.resource.data.reviewId == resource.data.reviewId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.productName == resource.data.productName
        && validReviewContent()
        && reviewOrderExists()
        && reviewOrderData().customerId == customerData().customerId
        && reviewOrderData().status == 'Delivered'
        && reviewOrderData().sellerIds is list
        && request.resource.data.sellerId in reviewOrderData().sellerIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating',
          'comment',
          'updatedAt'
        ]);

      // Admin moderation only.
      allow delete: if isAdmin();
    }


    // ============================================================
    // ADMIN NOTIFICATIONS
    // ============================================================
    //
    // audience values:
    // - customers : all customers
    // - sellers   : all sellers
    // - both      : all customers + all sellers
    // - customer  : one customer (targetCustomerId)
    // - seller    : one seller (targetSellerId)
    //
    // Only Admin can create/update/delete notifications.
    // Customers/Sellers can only read notifications meant for them.
    match /admin_notifications/{notificationId} {
      function customerCanReadNotification() {
        return hasCustomerSession()
          && resource.data.isActive == true
          && (
            resource.data.audience in ['customers', 'both']
            || (
              resource.data.audience == 'customer'
              && resource.data.targetCustomerId is string
              && resource.data.targetCustomerId == customerData().customerId
            )
          );
      }

      function sellerCanReadNotification() {
        return isActiveSeller()
          && resource.data.isActive == true
          && (
            resource.data.audience in ['sellers', 'both']
            || (
              resource.data.audience == 'seller'
              && resource.data.targetSellerId is string
              && resource.data.targetSellerId == request.auth.uid
            )
          );
      }

      allow read: if isAdmin()
        || customerCanReadNotification()
        || sellerCanReadNotification();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // RD RIDE FARE SETTINGS
    // ============================================================
    // Signed-in customers/drivers can read the current fare table.
    // Only Admin/SuperAdmin can create, update, or delete fare rates.
    match /ride_fare_settings/{fareId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }



    // ============================================================
    // RD TICKET BOOKINGS
    // ============================================================
    // Customer can create/read only their own booking requests.
    // Customers cannot self-confirm payment, provider verification,
    // PNR or e-ticket issuance. Those fields are locked on create.
    match /ticket_bookings/{bookingId} {
      function ticketOwner() {
        return signedIn()
          && resource.data.customerAuthUid == request.auth.uid;
      }

      allow read: if isAdmin() || ticketOwner();

      allow create: if signedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.bookingVersion == 2
        && request.resource.data.serviceType == 'flight'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerId is string

        && request.resource.data.tripType
          in ['one_way', 'round_trip']
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.from.size() <= 120
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() <= 120
        && request.resource.data.from
          != request.resource.data.to
        && request.resource.data.departureDate is timestamp
        && (
          request.resource.data.returnDate == null
          || request.resource.data.returnDate is timestamp
        )

        && request.resource.data.adultCount is int
        && request.resource.data.adultCount >= 1
        && request.resource.data.adultCount <= 9
        && request.resource.data.childCount is int
        && request.resource.data.childCount >= 0
        && request.resource.data.childCount <= 8
        && request.resource.data.infantCount is int
        && request.resource.data.infantCount >= 0
        && request.resource.data.infantCount
          <= request.resource.data.adultCount
        && request.resource.data.passengerCount is int
        && request.resource.data.passengerCount
          == request.resource.data.adultCount
            + request.resource.data.childCount
            + request.resource.data.infantCount
        && request.resource.data.passengerCount >= 1
        && request.resource.data.passengerCount <= 9
        && request.resource.data.passengerNames is list
        && request.resource.data.passengerNames.size()
          == request.resource.data.passengerCount
        && request.resource.data.passengerTypes is list
        && request.resource.data.passengerTypes.size()
          == request.resource.data.passengerCount

        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() >= 7
        && request.resource.data.contactPhone.size() <= 30
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 180
        && request.resource.data.cabinClass
          in ['Economy', 'Premium Economy', 'Business']
        && request.resource.data.directOnly is bool
        && request.resource.data.flexibleDates is bool

        && request.resource.data.airlineName is string
        && request.resource.data.airlineName.size() > 0
        && request.resource.data.flightNumber is string
        && request.resource.data.flightNumber.size() > 0
        && request.resource.data.outboundDeparture is timestamp
        && request.resource.data.outboundArrival is timestamp
        && (
          request.resource.data.returnDeparture == null
          || request.resource.data.returnDeparture is timestamp
        )
        && (
          request.resource.data.returnArrival == null
          || request.resource.data.returnArrival is timestamp
        )
        && request.resource.data.baggage is string
        && request.resource.data.refundable is bool

        && request.resource.data.baseFare is number
        && request.resource.data.baseFare >= 0
        && request.resource.data.taxes is number
        && request.resource.data.taxes >= 0
        && request.resource.data.serviceFee is number
        && request.resource.data.serviceFee >= 0
        && request.resource.data.totalFare is number
        && request.resource.data.totalFare >= 0
        && request.resource.data.totalFare
          >= request.resource.data.baseFare
            + request.resource.data.taxes
            + request.resource.data.serviceFee - 0.05
        && request.resource.data.totalFare
          <= request.resource.data.baseFare
            + request.resource.data.taxes
            + request.resource.data.serviceFee + 0.05
        && request.resource.data.currency == 'Rs.'

        && request.resource.data.quoteId is string
        && request.resource.data.quoteId.size() > 0
        && request.resource.data.quoteSource == 'demo'
        && request.resource.data.quoteExpiresAt is timestamp

        // Anti-fraud locks: customer cannot create a fake
        // verified/paid/issued ticket.
        && request.resource.data.providerVerified == false
        && request.resource.data.providerName == ''
        && request.resource.data.providerBookingReference == ''
        && request.resource.data.pnr == ''
        && request.resource.data.eTicketNumber == ''
        && request.resource.data.bookingStatus
          == 'request_submitted'
        && request.resource.data.paymentStatus
          == 'not_started'
        && request.resource.data.ticketStatus
          == 'not_issued'
        && request.resource.data.fraudReviewStatus
          == 'unreviewed'

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp

        && request.resource.data.keys().hasOnly([
          'bookingId',
          'bookingVersion',
          'serviceType',
          'customerAuthUid',
          'customerId',
          'tripType',
          'from',
          'to',
          'departureDate',
          'returnDate',
          'adultCount',
          'childCount',
          'infantCount',
          'passengerCount',
          'passengerNames',
          'passengerTypes',
          'contactPhone',
          'contactEmail',
          'cabinClass',
          'directOnly',
          'flexibleDates',
          'airlineName',
          'flightNumber',
          'outboundDeparture',
          'outboundArrival',
          'returnDeparture',
          'returnArrival',
          'baggage',
          'refundable',
          'baseFare',
          'taxes',
          'serviceFee',
          'totalFare',
          'currency',
          'quoteId',
          'quoteSource',
          'quoteExpiresAt',
          'providerVerified',
          'providerName',
          'providerBookingReference',
          'pnr',
          'eTicketNumber',
          'bookingStatus',
          'paymentStatus',
          'ticketStatus',
          'fraudReviewStatus',
          'createdAt',
          'updatedAt'
        ]);


      // Flight booking v3: richer passenger/preferences/payment foundation.
      // Keep this rule intentionally compact so Firestore can compile it
      // safely. Security-critical fields remain locked on customer create;
      // only Admin can later verify provider/payment or issue a real ticket.
      allow create: if signedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.bookingVersion == 3
        && request.resource.data.serviceType == 'flight'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerId is string

        && request.resource.data.travelScope
          in ['domestic', 'international']
        && request.resource.data.tripType
          in ['one_way', 'round_trip']
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.fromCode is string
        && request.resource.data.fromCode.size() == 3
        && request.resource.data.toCode is string
        && request.resource.data.toCode.size() == 3
        && request.resource.data.departureDate is timestamp

        && request.resource.data.adultCount is int
        && request.resource.data.adultCount >= 1
        && request.resource.data.childCount is int
        && request.resource.data.childCount >= 0
        && request.resource.data.infantCount is int
        && request.resource.data.infantCount >= 0
        && request.resource.data.infantCount
          <= request.resource.data.adultCount
        && request.resource.data.passengerCount is int
        && request.resource.data.passengerCount
          == request.resource.data.adultCount
            + request.resource.data.childCount
            + request.resource.data.infantCount
        && request.resource.data.passengerCount >= 1
        && request.resource.data.passengerCount <= 9
        && request.resource.data.passengerNames is list
        && request.resource.data.passengerNames.size()
          == request.resource.data.passengerCount
        && request.resource.data.passengerTypes is list
        && request.resource.data.passengerTypes.size()
          == request.resource.data.passengerCount
        && request.resource.data.passengerDob is list
        && request.resource.data.passengerDob.size()
          == request.resource.data.passengerCount

        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() >= 7
        && request.resource.data.contactEmail is string
        && request.resource.data.cabinClass
          in ['Economy', 'Premium Economy', 'Business', 'First Class']

        && request.resource.data.airlineName is string
        && request.resource.data.airlineName.size() > 0
        && request.resource.data.flightNumber is string
        && request.resource.data.flightNumber.size() > 0
        && request.resource.data.outboundDeparture is timestamp
        && request.resource.data.outboundArrival is timestamp

        && request.resource.data.baseFare is number
        && request.resource.data.baseFare >= 0
        && request.resource.data.taxes is number
        && request.resource.data.taxes >= 0
        && request.resource.data.serviceFee is number
        && request.resource.data.serviceFee >= 0
        && request.resource.data.totalFare is number
        && request.resource.data.totalFare >= 0
        && request.resource.data.currency == 'Rs.'

        && request.resource.data.paymentOption
          in ['online', 'pay_at_office']
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentReference == ''
        && (
          request.resource.data.paymentStatus == 'online_pending'
          || request.resource.data.paymentStatus == 'pay_at_office_pending'
        )

        && request.resource.data.quoteId is string
        && request.resource.data.quoteId.size() > 0
        && request.resource.data.quoteSource == 'demo'
        && request.resource.data.quoteExpiresAt is timestamp

        // Anti-fraud locks: customer cannot self-verify or self-issue.
        && request.resource.data.providerVerified == false
        && request.resource.data.providerName == ''
        && request.resource.data.providerBookingReference == ''
        && request.resource.data.pnr == ''
        && request.resource.data.eTicketNumber == ''
        && request.resource.data.qrVerificationToken == ''
        && request.resource.data.bookingStatus == 'request_submitted'
        && request.resource.data.ticketStatus == 'not_issued'
        && request.resource.data.fraudReviewStatus == 'unreviewed'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Only trusted admin-side workflow can review/change
      // provider/payment/ticket issuance fields.
      allow update, delete: if isAdmin();
    }



    // ============================================================
    // RD FLIGHT CANCELLATION / REFUND REQUESTS
    // ============================================================
    match /flight_cancellation_requests/{requestId} {
      function cancellationOwner() {
        return signedIn()
          && resource.data.customerAuthUid == request.auth.uid;
      }

      function sourceFlightBookingExists() {
        return request.resource.data.bookingId is string
          && exists(
            /databases/$(database)/documents/ticket_bookings/$(request.resource.data.bookingId)
          );
      }

      function sourceFlightBooking() {
        return get(
          /databases/$(database)/documents/ticket_bookings/$(request.resource.data.bookingId)
        ).data;
      }

      allow read: if isAdmin() || cancellationOwner();

      allow create: if signedIn()
        && request.resource.data.requestId == requestId
        && request.resource.data.customerAuthUid == request.auth.uid
        && sourceFlightBookingExists()
        && sourceFlightBooking().serviceType == 'flight'
        && sourceFlightBooking().customerAuthUid == request.auth.uid
        && request.resource.data.bookingId
          == sourceFlightBooking().bookingId
        && request.resource.data.airlineName is string
        && request.resource.data.flightNumber is string
        && request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'requestId',
          'bookingId',
          'customerAuthUid',
          'airlineName',
          'flightNumber',
          'from',
          'to',
          'reason',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // RD FLIGHT PUBLIC QR / TOKEN VERIFICATION
    // ============================================================
    match /flight_ticket_public_verify/{token} {
      // App users, including the anonymous customer session, can verify
      // a token. Only Admin may create/change verification records.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // RD BUS OPERATORS
    // ============================================================
    match /bus_operators/{operatorId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == operatorId
        );

      // Registration creates only a pending/unapproved operator.
      allow create: if signedIn()
        && request.auth.uid == operatorId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.role == 'busOperator'
        && request.resource.data.isApproved == false
        && request.resource.data.isActive == false
        && request.resource.data.status == 'pending'
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string
        && request.resource.data.email is string;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == operatorId
          && request.resource.data.authUid
            == resource.data.authUid
          && request.resource.data.operatorId
            == resource.data.operatorId
          && request.resource.data.role
            == resource.data.role
          && request.resource.data.isApproved
            == resource.data.isApproved
          && request.resource.data.isActive
            == resource.data.isActive
          && request.resource.data.status
            == resource.data.status
          && request.resource.data.get('isOnline', false) is bool
          && request.resource.data.get('serviceStatus', 'offline')
            == (
              request.resource.data.get('isOnline', false)
                ? 'online'
                : 'offline'
            )
          && (
            request.resource.data.get('isOnline', false) == false
            || (
              resource.data.isApproved == true
              && resource.data.isActive == true
            )
          )
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'companyName',
              'ownerName',
              'phone',
              'address',
              'registrationNumber',
              'email',
              'lastLoginAt',
              'isOnline',
              'serviceStatus',
              'serviceStatusUpdatedAt',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD BUS OPERATOR PUBLIC PRESENCE
    // ============================================================
    match /bus_operator_presence/{operatorId} {
      function validBusPresenceWrite() {
        return request.resource.data.keys().hasOnly([
            'operatorId',
            'isOnline',
            'serviceStatus',
            'updatedAt'
          ])
          && request.resource.data.operatorId == operatorId
          && request.resource.data.isOnline is bool
          && request.resource.data.serviceStatus
            == (
              request.resource.data.isOnline
                ? 'online'
                : 'offline'
            )
          && request.resource.data.updatedAt is timestamp;
      }

      // Customers can read only this small public service-presence document.
      allow read: if signedIn();

      allow create, update: if isAdmin()
        || (
          isActiveBusOperator()
          && request.auth.uid == operatorId
          && validBusPresenceWrite()
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD BUS SCHEDULES
    // ============================================================
    match /bus_schedules/{scheduleId} {
      // Signed-in users can search schedules. Customer app itself
      // only shows active + fare-approved schedules.
      allow read: if signedIn();

      // New operator schedules always start with PENDING fare approval.
      // Admin approval is required before the schedule can become active.
      allow create: if isActiveBusOperator()
        && request.resource.data.scheduleId == scheduleId
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.operatorName
          == busOperatorData().companyName
        && request.resource.data.operatorPhone
          == busOperatorData().phone
        && request.resource.data.busStaffName is string
        && request.resource.data.busStaffName.size() > 0
        && request.resource.data.busStaffName.size() <= 120
        && request.resource.data.busStaffPhone is string
        && request.resource.data.busStaffPhone.size() >= 7
        && request.resource.data.busStaffPhone.size() <= 30
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.routeDateKey is string
        && request.resource.data.routeDateKey.size() > 0
        && request.resource.data.travelDate is timestamp
        && request.resource.data.busName is string
        && request.resource.data.busName.size() > 0
        && request.resource.data.busNumber is string
        && request.resource.data.busNumber.size() > 0
        && request.resource.data.busType is string
        && request.resource.data.busType.size() > 0
        && request.resource.data.seatLayout in ['2+2', '2+1', '1+1']
        && request.resource.data.seatRows is int
        && request.resource.data.seatRows >= 5
        && request.resource.data.seatRows <= 14
        && request.resource.data.seatCodes is list
        && request.resource.data.seatCodes.size() > 0
        && request.resource.data.departureAt is timestamp
        && request.resource.data.arrivalAt is timestamp
        && request.resource.data.boardingPoints is list
        && request.resource.data.boardingPoints.size() > 0
        && request.resource.data.dropPoints is list
        && request.resource.data.dropPoints.size() > 0
        && request.resource.data.farePerSeat is number
        && request.resource.data.farePerSeat >= 0
        && request.resource.data.pendingFarePerSeat is number
        && request.resource.data.pendingFarePerSeat
          == request.resource.data.farePerSeat
        && request.resource.data.serviceFee == 0
        && request.resource.data.commissionPercent
          == busOperatorData().get('commissionPercent', 0)
        && request.resource.data.currency == 'Rs.'
        && request.resource.data.isActive == false
        && request.resource.data.requestedActive is bool
        && request.resource.data.fareApprovalStatus == 'pending'
        && request.resource.data.fareEverApproved == false
        && request.resource.data.fareChangeRequestedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Admin may approve/reject fare and change any schedule fields.
      allow update: if isAdmin();

      // Operator may edit own schedule details, request a new fare,
      // or toggle active state after the schedule has been approved.
      // The already-approved fare itself and RD commission cannot be
      // changed directly by the operator.
      allow update: if isActiveBusOperator()
        && resource.data.operatorId == request.auth.uid
        && request.resource.data.operatorId == resource.data.operatorId
        && request.resource.data.scheduleId == resource.data.scheduleId
        && request.resource.data.operatorName == busOperatorData().companyName
        && request.resource.data.operatorPhone == busOperatorData().phone
        && request.resource.data.farePerSeat == resource.data.farePerSeat
        && (
          request.resource.data.get('serviceFee', 0) == 0
          || request.resource.data.get('serviceFee', 0)
            == resource.data.get('serviceFee', 0)
        )
        && (
          request.resource.data.get(
            'commissionPercent',
            resource.data.get('commissionPercent', 0)
          ) == resource.data.get('commissionPercent', 0)
          || request.resource.data.get('commissionPercent', 0)
            == busOperatorData().get('commissionPercent', 0)
        )
        && request.resource.data.requestedActive is bool
        && request.resource.data.get('fareEverApproved', true)
          == resource.data.get('fareEverApproved', true)
        && (
          // No fare-status change: normal schedule edit / active toggle.
          (
            request.resource.data.get('fareApprovalStatus', 'approved')
              == resource.data.get('fareApprovalStatus', 'approved')
            && request.resource.data.get('pendingFarePerSeat', -1)
              == resource.data.get('pendingFarePerSeat', -1)
          )
          ||
          // Submit or replace a pending fare request.
          (
            request.resource.data.fareApprovalStatus == 'pending'
            && request.resource.data.pendingFarePerSeat is number
            && request.resource.data.pendingFarePerSeat >= 0
            && request.resource.data.fareChangeRequestedBy
              == request.auth.uid
          )
          ||
          // Cancel a pending/rejected request by returning to the
          // already-approved fare. The approved fare value is unchanged.
          (
            request.resource.data.fareApprovalStatus == 'approved'
            && !request.resource.data.keys().hasAny(['pendingFarePerSeat'])
          )
        )
        && (
          request.resource.data.isActive == resource.data.isActive
          || resource.data.get('fareEverApproved', true) == true
        );

      allow delete: if isAdmin()
        || (
          isActiveBusOperator()
          && resource.data.operatorId == request.auth.uid
        );
    }

    // ============================================================
    // RD BUS SEAT LOCKS
    // ============================================================
    match /bus_seat_locks/{lockId} {
      // Customers need to see occupied seat codes.
      allow read: if signedIn();

      allow create: if isAdmin()
        || (
          isActiveBusOperator()
          && request.resource.data.operatorId
            == request.auth.uid
          && request.resource.data.scheduleId is string
          && request.resource.data.bookingId is string
          && exists(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          )
          && get(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.operatorId == request.auth.uid
        )
        || (
          // Customer may reserve a selected seat only as part of
          // the same atomic transaction that creates their booking.
          signedIn()
          && request.resource.data.customerAuthUid
            == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.status == 'reserved'
          && request.resource.data.scheduleId is string
          && request.resource.data.bookingId is string
          && request.resource.data.operatorId is string
          && request.resource.data.seat is string
          && existsAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          )
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.customerAuthUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.bookingId == request.resource.data.bookingId
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.scheduleId == request.resource.data.scheduleId
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.operatorId == request.resource.data.operatorId
          && request.resource.data.seat in getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.selectedSeats
        );

      allow update: if isAdmin()
        || (
          isActiveBusOperator()
          && resource.data.operatorId == request.auth.uid
          && request.resource.data.operatorId
            == resource.data.operatorId
        )
        || (
          // Customer may reuse only an INACTIVE old seat-lock
          // while atomically creating their own booking.
          signedIn()
          && resource.data.get('active', false) == false
          && request.resource.data.customerAuthUid
            == request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.status == 'reserved'
          && request.resource.data.scheduleId
            == resource.data.scheduleId
          && request.resource.data.seat
            == resource.data.seat
          && request.resource.data.bookingId is string
          && request.resource.data.operatorId is string
          && existsAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          )
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.customerAuthUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.scheduleId == request.resource.data.scheduleId
          && getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.operatorId == request.resource.data.operatorId
          && request.resource.data.seat in getAfter(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.selectedSeats
          && request.resource.data.keys().hasOnly([
            'lockId',
            'operatorId',
            'scheduleId',
            'bookingId',
            'customerAuthUid',
            'seat',
            'status',
            'active',
            'reservedAt'
          ])
        );

      allow delete: if isAdmin()
        || (
          isActiveBusOperator()
          && resource.data.operatorId == request.auth.uid
        );
    }

    // ============================================================
    // RD BUS PUBLIC TICKET VERIFICATION
    // ============================================================
    match /bus_ticket_public_verify/{verificationToken} {
      // Exact-token ticket verification.
      allow get: if signedIn();
      allow list: if false;

      allow create: if isAdmin()
        || (
          isActiveBusOperator()
          && request.resource.data.operatorId
            == request.auth.uid
          && request.resource.data.bookingId is string
          && exists(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          )
          && get(
            /databases/$(database)/documents/bus_ticket_bookings/$(request.resource.data.bookingId)
          ).data.operatorId == request.auth.uid
        );

      allow update, delete: if isAdmin()
        || (
          isActiveBusOperator()
          && (
            resource.data.get('operatorId', '') == request.auth.uid
            || (
              resource.data.bookingId is string
              && exists(
                /databases/$(database)/documents/bus_ticket_bookings/$(resource.data.bookingId)
              )
              && get(
                /databases/$(database)/documents/bus_ticket_bookings/$(resource.data.bookingId)
              ).data.operatorId == request.auth.uid
            )
          )
          && request.resource.data.get('operatorId', request.auth.uid)
            == request.auth.uid
        );
    }

    // ============================================================
    // RD BUS OPERATOR MONTHLY FEE PAYMENTS
    // ============================================================
    match /bus_operator_monthly_fee_payments/{paymentId} {
      function paymentOperatorExists() {
        return request.resource.data.operatorId is string
          && exists(
            /databases/$(database)/documents/bus_operators/$(request.resource.data.operatorId)
          );
      }

      function paymentOperatorData() {
        return get(
          /databases/$(database)/documents/bus_operators/$(request.resource.data.operatorId)
        ).data;
      }

      function immutablePaymentCore() {
        return request.resource.data.paymentId == resource.data.paymentId
          && request.resource.data.operatorId == resource.data.operatorId
          && request.resource.data.operatorName == resource.data.operatorName
          && request.resource.data.operatorPhone == resource.data.operatorPhone
          && request.resource.data.monthKey == resource.data.monthKey
          && request.resource.data.monthLabel == resource.data.monthLabel
          && request.resource.data.year == resource.data.year
          && request.resource.data.month == resource.data.month
          && request.resource.data.monthlyFeeAmount
            == resource.data.monthlyFeeAmount
          && request.resource.data.commissionPercentSnapshot
            == resource.data.commissionPercentSnapshot
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isAdmin()
        || (
          isActiveBusOperator()
          && resource.data.operatorId == request.auth.uid
        );

      // Operator submits only bank/wallet/online proof. Operator cannot mark PAID.
      allow create: if isActiveBusOperator()
        && request.resource.data.keys().hasOnly([
          'paymentId',
          'receiptNumber',
          'operatorId',
          'operatorName',
          'operatorPhone',
          'monthKey',
          'monthLabel',
          'year',
          'month',
          'monthlyFeeAmount',
          'commissionPercentSnapshot',
          'paymentStatus',
          'paymentMethod',
          'paymentReference',
          'submittedByOperatorUid',
          'recordedByAdminUid',
          'submittedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.paymentId == paymentId
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.operatorName
          == busOperatorData().companyName
        && request.resource.data.operatorPhone
          == busOperatorData().phone
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.size() == 6
        && request.resource.data.monthLabel is string
        && request.resource.data.year is int
        && request.resource.data.month is int
        && request.resource.data.month >= 1
        && request.resource.data.month <= 12
        && request.resource.data.monthlyFeeAmount is number
        && request.resource.data.monthlyFeeAmount
          == busOperatorData().get('monthlyFee', 0)
        && request.resource.data.monthlyFeeAmount > 0
        && request.resource.data.commissionPercentSnapshot
          == busOperatorData().get('commissionPercent', 0)
        && request.resource.data.paymentStatus == 'submitted'
        && request.resource.data.paymentMethod
          in ['Bank', 'eSewa', 'Khalti', 'connectIPS', 'Other']
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 0
        && request.resource.data.paymentReference.size() <= 200
        && request.resource.data.submittedByOperatorUid == request.auth.uid
        && request.resource.data.recordedByAdminUid == ''
        && request.resource.data.receiptNumber == '';

      // A rejected proof may be corrected and resubmitted by the same operator.
      allow update: if isActiveBusOperator()
        && resource.data.operatorId == request.auth.uid
        && resource.data.paymentStatus == 'rejected'
        && immutablePaymentCore()
        && request.resource.data.paymentStatus == 'submitted'
        && request.resource.data.paymentMethod
          in ['Bank', 'eSewa', 'Khalti', 'connectIPS', 'Other']
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 0
        && request.resource.data.paymentReference.size() <= 200
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus',
          'paymentMethod',
          'paymentReference',
          'submittedAt',
          'updatedAt'
        ]);

      // Admin may record cash directly as PAID when no record exists.
      allow create: if isAdmin()
        && paymentOperatorExists()
        && request.resource.data.paymentId == paymentId
        && request.resource.data.operatorName
          == paymentOperatorData().companyName
        && request.resource.data.operatorPhone
          == paymentOperatorData().phone
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.size() == 6
        && request.resource.data.year is int
        && request.resource.data.month is int
        && request.resource.data.month >= 1
        && request.resource.data.month <= 12
        && request.resource.data.monthlyFeeAmount is number
        && request.resource.data.monthlyFeeAmount
          == paymentOperatorData().get('monthlyFee', 0)
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.paymentMethod == 'Cash'
        && request.resource.data.paymentReference == ''
        && request.resource.data.receiptNumber is string
        && request.resource.data.receiptNumber.size() > 0
        && request.resource.data.recordedByAdminUid == request.auth.uid;

      // Admin verifies submitted proof, rejects it, or records cash after rejection.
      allow update: if isAdmin()
        && immutablePaymentCore()
        && (
          (
            resource.data.paymentStatus == 'submitted'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.receiptNumber is string
            && request.resource.data.receiptNumber.size() > 0
            && request.resource.data.recordedByAdminUid == request.auth.uid
            && request.resource.data.verifiedByAdminUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'receiptNumber',
              'recordedByAdminUid',
              'verifiedByAdminUid',
              'verifiedAt',
              'paidAt',
              'updatedAt'
            ])
          )
          || (
            resource.data.paymentStatus == 'submitted'
            && request.resource.data.paymentStatus == 'rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectedByAdminUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'rejectionReason',
              'rejectedByAdminUid',
              'rejectedAt',
              'updatedAt'
            ])
          )
          || (
            resource.data.paymentStatus == 'rejected'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.paymentMethod == 'Cash'
            && request.resource.data.paymentReference == ''
            && request.resource.data.receiptNumber is string
            && request.resource.data.receiptNumber.size() > 0
            && request.resource.data.recordedByAdminUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'paymentMethod',
              'paymentReference',
              'receiptNumber',
              'recordedByAdminUid',
              'paidAt',
              'updatedAt'
            ])
          )
        );

      // Financial ledger records are never deleted from the app.
      allow delete: if false;
    }

    // ============================================================
    // RD BUS TICKET BOOKINGS
    // ============================================================
    match /bus_ticket_bookings/{bookingId} {
      function busTicketOwner() {
        return signedIn()
          && resource.data.customerAuthUid == request.auth.uid;
      }

      function busOperatorOwnBooking() {
        return isActiveBusOperator()
          && resource.data.operatorId == request.auth.uid;
      }

      function bookingScheduleExists() {
        return exists(
          /databases/$(database)/documents/bus_schedules/$(request.resource.data.scheduleId)
        );
      }

      function bookingScheduleData() {
        return get(
          /databases/$(database)/documents/bus_schedules/$(request.resource.data.scheduleId)
        ).data;
      }

      allow read: if isAdmin()
        || busTicketOwner()
        || busOperatorOwnBooking();

      // Customer creates a booking from an ACTIVE schedule.
      // Keep the security-critical checks strict (customer, schedule,
      // seat codes, fare, payment/status), but do not re-compare every
      // display-only snapshot field. That avoids false PERMISSION_DENIED
      // failures from harmless legacy/format differences.
      allow create: if signedIn()
        && bookingScheduleExists()
        && bookingScheduleData().isActive == true

        && request.resource.data.bookingId == bookingId
        && request.resource.data.bookingCode is string
        && request.resource.data.bookingCode.size() > 0
        && request.resource.data.bookingVersion == 2
        && request.resource.data.serviceType == 'bus'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerId is string

        && request.resource.data.scheduleId is string
        && request.resource.data.operatorId
          == bookingScheduleData().operatorId
        && request.resource.data.from
          == bookingScheduleData().from
        && request.resource.data.to
          == bookingScheduleData().to

        && request.resource.data.passengerCount is int
        && request.resource.data.passengerCount >= 1
        && request.resource.data.passengerCount <= 6
        && request.resource.data.passengerNames is list
        && request.resource.data.passengerNames.size()
          == request.resource.data.passengerCount
        && request.resource.data.passengerPhones is list
        && request.resource.data.passengerPhones.size()
          == request.resource.data.passengerCount
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() >= 7
        && request.resource.data.contactPhone.size() <= 30
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 180

        && request.resource.data.boardingPoint is string
        && request.resource.data.boardingPoint
          in bookingScheduleData().boardingPoints
        && request.resource.data.dropPoint is string
        && request.resource.data.dropPoint
          in bookingScheduleData().dropPoints

        && request.resource.data.selectedSeats is list
        && request.resource.data.selectedSeats.size()
          == request.resource.data.passengerCount
        && request.resource.data.selectedSeats.toSet().size()
          == request.resource.data.passengerCount
        && request.resource.data.selectedSeats.hasOnly(
          bookingScheduleData().seatCodes
        )

        && request.resource.data.farePerSeat
          == bookingScheduleData().farePerSeat
        && request.resource.data.serviceFee == 0
        && request.resource.data.baseFare is number
        && request.resource.data.baseFare
          >= bookingScheduleData().farePerSeat
            * request.resource.data.passengerCount - 0.05
        && request.resource.data.baseFare
          <= bookingScheduleData().farePerSeat
            * request.resource.data.passengerCount + 0.05

        && request.resource.data.commissionPercent is number
        && request.resource.data.commissionPercent >= 0
        && request.resource.data.commissionPercent <= 100
        && (
          !bookingScheduleData().keys().hasAny(['commissionPercent'])
          || request.resource.data.commissionPercent
            == bookingScheduleData().commissionPercent
        )
        && request.resource.data.rdCommissionAmount is number
        && request.resource.data.rdCommissionAmount
          >= request.resource.data.baseFare
            * request.resource.data.commissionPercent / 100 - 0.05
        && request.resource.data.rdCommissionAmount
          <= request.resource.data.baseFare
            * request.resource.data.commissionPercent / 100 + 0.05
        && request.resource.data.operatorNetAmount is number
        && request.resource.data.operatorNetAmount
          >= request.resource.data.baseFare
            - request.resource.data.rdCommissionAmount - 0.05
        && request.resource.data.operatorNetAmount
          <= request.resource.data.baseFare
            - request.resource.data.rdCommissionAmount + 0.05
        && request.resource.data.totalFare is number
        && request.resource.data.totalFare
          >= request.resource.data.baseFare - 0.05
        && request.resource.data.totalFare
          <= request.resource.data.baseFare + 0.05
        && request.resource.data.currency == 'Rs.'
        && request.resource.data.scheduleSource == 'operator'

        && request.resource.data.paymentOption
          in ['online', 'pay_on_bus']
        && (
          (
            request.resource.data.paymentOption == 'pay_on_bus'
            && request.resource.data.paymentMethod == 'Pay on Bus'
            && request.resource.data.paymentStatus
              == 'pay_on_bus_pending'
          )
          || (
            request.resource.data.paymentOption == 'online'
            && request.resource.data.paymentMethod
              in ['eSewa', 'Khalti', 'connectIPS', 'Bank', 'Card']
            && request.resource.data.paymentStatus
              == 'online_pending'
          )
        )
        && request.resource.data.paymentReference == ''

        && request.resource.data.operatorVerified == false
        && request.resource.data.seatLockStatus == 'reserved'
        && request.resource.data.bookingStatus
          == 'request_submitted'
        && request.resource.data.ticketStatus == 'not_issued'
        && request.resource.data.qrVerificationToken == ''

        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp

        && request.resource.data.keys().hasOnly([
          'bookingId',
          'bookingCode',
          'bookingVersion',
          'serviceType',
          'customerAuthUid',
          'customerId',
          'from',
          'to',
          'travelDate',
          'passengerCount',
          'passengerNames',
          'passengerPhones',
          'contactPhone',
          'contactEmail',
          'scheduleId',
          'operatorId',
          'operatorName',
          'operatorPhone',
          'busStaffName',
          'busStaffPhone',
          'busName',
          'busNumber',
          'busType',
          'departureAt',
          'arrivalAt',
          'boardingPoint',
          'dropPoint',
          'selectedSeats',
          'farePerSeat',
          'baseFare',
          'serviceFee',
          'commissionPercent',
          'rdCommissionAmount',
          'operatorNetAmount',
          'totalFare',
          'currency',
          'scheduleSource',
          'operatorVerified',
          'seatLockStatus',
          'paymentOption',
          'paymentMethod',
          'paymentReference',
          'paymentStatus',
          'bookingStatus',
          'ticketStatus',
          'qrVerificationToken',
          'createdAt',
          'updatedAt'
        ]);

      // Admin controls every booking.
      allow update, delete: if isAdmin();

      // Approved Bus Operator may update only status/verification
      // fields on its own bookings. Customer/fare/operator identity
      // fields remain immutable.
      allow update: if busOperatorOwnBooking()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'operatorVerified',
            'operatorVerifiedAt',
            'seatLockStatus',
            'paymentStatus',
            'paidAt',
            'bookingStatus',
            'ticketStatus',
            'qrVerificationToken',
            'issuedAt',
            'cancelReason',
            'cancelledAt',
            'boardingStatus',
            'boardingConfirmedAt',
            'boardingConfirmedBy',
            'boardingConfirmationMethod',
            'updatedAt'
          ])
        && (
          request.resource.data.paymentStatus
            == resource.data.paymentStatus
          || (
            resource.data.paymentOption == 'pay_on_bus'
            && request.resource.data.paymentStatus == 'paid'
          )
          || (
            resource.data.paymentStatus == 'paid'
            && request.resource.data.paymentStatus
              == 'refund_pending'
          )
        );

      allow delete: if false;
    }


    // ============================================================
    // RD HOTEL PARTNERS
    // ============================================================
    match /hotel_partners/{partnerId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == partnerId
        );

      allow create: if signedIn()
        && request.auth.uid == partnerId
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role == 'hotel_partner'
        && request.resource.data.isApproved == false
        && request.resource.data.isActive == false
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == partnerId
          && request.resource.data.partnerId == resource.data.partnerId
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.status == resource.data.status
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'businessName',
              'ownerName',
              'phone',
              'email',
              'address',
              'registrationNumber',
              'panVatNumber',
              'photoUrl',
              'documentUrls',
              'bankName',
              'bankAccountName',
              'bankAccountNumber',
              'latitude',
              'longitude',
              'locationUpdatedAt',
              'lastLoginAt',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD HOTELS
    // ============================================================
    match /hotels/{hotelId} {
      function ownsHotel() {
        return isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid;
      }

      function ownsNewHotel() {
        return isActiveHotelPartner()
          && request.resource.data.partnerId == request.auth.uid;
      }

      allow read: if isAdmin()
        || ownsHotel()
        || (
          signedIn()
          && resource.data.isApproved == true
          && resource.data.isActive == true
        );

      allow create: if ownsNewHotel()
        && request.resource.data.hotelId == hotelId
        && request.resource.data.isApproved == false
        && request.resource.data.isActive == false
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.location is string
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7;

      allow update: if isAdmin()
        || (
          ownsHotel()
          && request.resource.data.hotelId == resource.data.hotelId
          && request.resource.data.partnerId == resource.data.partnerId
          && request.resource.data.isApproved == resource.data.isApproved
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.status == resource.data.status
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'description',
              'location',
              'address',
              'city',
              'area',
              'phone',
              'email',
              'coverUrl',
              'profileUrl',
              'photoUrls',
              'facilities',
              'latitude',
              'longitude',
              'checkInTime',
              'checkOutTime',
              'cancellationPolicy',
              'houseRules',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL ROOMS
    // ============================================================
    match /hotel_rooms/{roomId} {
      function roomHotelExists() {
        return resource.data.hotelId is string
          && exists(
            /databases/$(database)/documents/hotels/$(resource.data.hotelId)
          );
      }

      function roomHotelData() {
        return get(
          /databases/$(database)/documents/hotels/$(resource.data.hotelId)
        ).data;
      }

      function newRoomHotelExists() {
        return request.resource.data.hotelId is string
          && exists(
            /databases/$(database)/documents/hotels/$(request.resource.data.hotelId)
          );
      }

      function newRoomHotelData() {
        return get(
          /databases/$(database)/documents/hotels/$(request.resource.data.hotelId)
        ).data;
      }

      function ownsRoom() {
        return isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid;
      }

      allow read: if isAdmin()
        || ownsRoom()
        || (
          signedIn()
          && resource.data.isActive == true
          && roomHotelExists()
          && roomHotelData().isApproved == true
          && roomHotelData().isActive == true
        );

      allow create: if isActiveHotelPartner()
        && request.resource.data.roomId == roomId
        && request.resource.data.partnerId == request.auth.uid
        && newRoomHotelExists()
        && newRoomHotelData().partnerId == request.auth.uid
        && newRoomHotelData().isApproved == true
        && newRoomHotelData().isActive == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.pricePerNight is number
        && request.resource.data.pricePerNight >= 0
        && request.resource.data.totalRooms is int
        && request.resource.data.totalRooms >= 1
        && request.resource.data.isActive == true;

      allow update: if isAdmin()
        || (
          ownsRoom()
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.hotelId == resource.data.hotelId
          && request.resource.data.partnerId == resource.data.partnerId
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'description',
              'roomClass',
              'isAc',
              'bed',
              'maxGuests',
              'pricePerNight',
              'totalRooms',
              'photoUrl',
              'photoUrls',
              'facilities',
              'breakfastIncluded',
              'freeCancellation',
              'isActive',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL DATE-WISE ROOM INVENTORY
    // ============================================================
    match /hotel_room_inventory/{inventoryId} {
      function validInventoryCounts() {
        return request.resource.data.totalRooms is int
          && request.resource.data.blockedRooms is int
          && request.resource.data.bookedRooms is int
          && request.resource.data.availableRooms is int
          && request.resource.data.totalRooms >= 0
          && request.resource.data.blockedRooms >= 0
          && request.resource.data.bookedRooms >= 0
          && request.resource.data.availableRooms >= 0
          && request.resource.data.blockedRooms
            + request.resource.data.bookedRooms
            + request.resource.data.availableRooms
            == request.resource.data.totalRooms;
      }

      function ownsNewInventory() {
        return isActiveHotelPartner()
          && request.resource.data.partnerId == request.auth.uid;
      }

      function ownsInventory() {
        return isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid;
      }

      allow read: if signedIn();

      allow create: if isAdmin()
        || (
          ownsNewInventory()
          && request.resource.data.inventoryId == inventoryId
          && request.resource.data.hotelId is string
          && request.resource.data.roomId is string
          && request.resource.data.date is timestamp
          && request.resource.data.isOpen is bool
          && validInventoryCounts()
        );

      allow update: if isAdmin()
        || (
          ownsInventory()
          && request.resource.data.inventoryId == resource.data.inventoryId
          && request.resource.data.hotelId == resource.data.hotelId
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.partnerId == resource.data.partnerId
          && request.resource.data.date == resource.data.date
          && request.resource.data.isOpen is bool
          && validInventoryCounts()
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'totalRooms',
              'blockedRooms',
              'bookedRooms',
              'availableRooms',
              'isOpen',
              'lastBookingId',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL BOOKINGS
    // ============================================================
    match /hotel_bookings/{bookingId} {
      function hotelBookingOwner() {
        return signedIn()
          && resource.data.customerAuthUid == request.auth.uid;
      }

      function hotelPartnerOwnBooking() {
        return isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid;
      }

      function bookingHotelExists() {
        return request.resource.data.hotelId is string
          && exists(
            /databases/$(database)/documents/hotels/$(request.resource.data.hotelId)
          );
      }

      function bookingHotelData() {
        return get(
          /databases/$(database)/documents/hotels/$(request.resource.data.hotelId)
        ).data;
      }

      function bookingRoomExists() {
        return request.resource.data.roomId is string
          && exists(
            /databases/$(database)/documents/hotel_rooms/$(request.resource.data.roomId)
          );
      }

      function bookingRoomData() {
        return get(
          /databases/$(database)/documents/hotel_rooms/$(request.resource.data.roomId)
        ).data;
      }

      allow read: if isAdmin()
        || hotelBookingOwner()
        || hotelPartnerOwnBooking();

      allow create: if signedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.serviceType == 'hotel'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerId is string
        && bookingHotelExists()
        && bookingRoomExists()
        && bookingHotelData().isApproved == true
        && bookingHotelData().isActive == true
        && bookingRoomData().isActive == true
        && request.resource.data.partnerId == bookingHotelData().partnerId
        && request.resource.data.partnerId == bookingRoomData().partnerId
        && request.resource.data.hotelId == bookingRoomData().hotelId
        && request.resource.data.checkIn is timestamp
        && request.resource.data.checkOut is timestamp
        && request.resource.data.checkOut > request.resource.data.checkIn
        && request.resource.data.roomCount is int
        && request.resource.data.roomCount >= 1
        && request.resource.data.roomCount <= bookingRoomData().totalRooms
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() >= 2
        && request.resource.data.guestPhone is string
        && request.resource.data.guestPhone.size() >= 7
        && request.resource.data.pricePerNight == bookingRoomData().pricePerNight
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.currency == 'Rs.'
        && request.resource.data.paymentOption
          in ['pay_at_hotel', 'online']
        && (
          (
            request.resource.data.paymentOption == 'pay_at_hotel'
            && request.resource.data.paymentStatus == 'pay_at_hotel_pending'
          )
          || (
            request.resource.data.paymentOption == 'online'
            && request.resource.data.paymentStatus == 'online_pending'
          )
        )
        && request.resource.data.bookingStatus == 'request_submitted'
        && request.resource.data.confirmationStatus == 'pending'
        && request.resource.data.get('partnerConfirmed', false) == false
        && request.resource.data.get('adminConfirmed', false) == false
        && request.resource.data.get('refundStatus', 'none') == 'none'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isAdmin();

      allow update: if hotelPartnerOwnBooking()
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.customerAuthUid == resource.data.customerAuthUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.hotelId == resource.data.hotelId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.checkIn == resource.data.checkIn
        && request.resource.data.checkOut == resource.data.checkOut
        && request.resource.data.roomCount == resource.data.roomCount
        && request.resource.data.pricePerNight == resource.data.pricePerNight
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'bookingStatus',
            'confirmationStatus',
            'partnerConfirmed',
            'confirmedAt',
            'rejectionReason',
            'rejectedAt',
            'paymentStatus',
            'paidAt',
            'updatedAt'
          ]);

      allow update: if hotelBookingOwner()
        && resource.data.bookingStatus
          in ['request_submitted', 'confirmed']
        && request.resource.data.bookingStatus == 'cancel_requested'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'bookingStatus',
            'cancellationReason',
            'cancelRequestedAt',
            'updatedAt'
          ]);

      allow delete: if false;
    }


    // ============================================================
    // RD HOTEL FEE SETTINGS
    // Admin controls monthly fee, commission, due date and
    // payment instructions. Approved Hotel Partners can read it.
    // ============================================================
    match /hotel_fee_settings/{settingId} {
      allow read: if isAdmin()
        || isActiveHotelPartner();

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL FEE INVOICES
    // Invoice calculation / status is Admin-controlled.
    // A Hotel Partner can only read its own invoices.
    // ============================================================
    match /hotel_fee_invoices/{invoiceId} {
      allow read: if isAdmin()
        || (
          isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL FEE PAYMENTS
    // Hotel Partner may submit payment proof only for an invoice
    // that belongs to the same authenticated Hotel Partner.
    // Verification / rejection is Admin-only.
    // ============================================================
    match /hotel_fee_payments/{paymentId} {
      function feeInvoiceExists() {
        return request.resource.data.invoiceId is string
          && exists(
            /databases/$(database)/documents/hotel_fee_invoices/$(request.resource.data.invoiceId)
          );
      }

      function feeInvoiceData() {
        return get(
          /databases/$(database)/documents/hotel_fee_invoices/$(request.resource.data.invoiceId)
        ).data;
      }

      allow read: if isAdmin()
        || (
          isActiveHotelPartner()
          && resource.data.partnerId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isActiveHotelPartner()
          && request.resource.data.paymentId == paymentId
          && request.resource.data.partnerId == request.auth.uid
          && feeInvoiceExists()
          && feeInvoiceData().partnerId == request.auth.uid
          && request.resource.data.hotelId == feeInvoiceData().hotelId
          && request.resource.data.billingMonth == feeInvoiceData().billingMonth
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && feeInvoiceData().status == 'unpaid'
          && request.resource.data.amount
            <= feeInvoiceData().totalDue - feeInvoiceData().paidAmount
          && request.resource.data.method
            in [
              'bank_transfer',
              'mobile_banking',
              'ewallet',
              'other'
            ]
          && request.resource.data.transactionRef is string
          && request.resource.data.proofUrl is string
          && request.resource.data.note is string
          && request.resource.data.status == 'submitted'
          && request.resource.data.submittedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        );

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // RD HOTEL FEE ADMIN AUDIT LOG
    // Keeps a server-side Firestore history of fee settings,
    // invoice, payment verification, cash and waive actions.
    // ============================================================
    match /hotel_fee_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
